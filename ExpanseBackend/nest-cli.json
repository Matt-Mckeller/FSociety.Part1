{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/expanse-backend/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/expanse-backend/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/expanse-backend",
  "projects": {
    "expanse-backend": {
      "type": "application",
      "root": "apps/expanse-backend",
      "entryFile": "main",
      "sourceRoot": "apps/expanse-backend/src",
      "compilerOptions": {
        "tsConfigPath": "apps/expanse-backend/tsconfig.app.json"
      }
    },
    "user": {
      "type": "application",
      "root": "apps/user",
      "entryFile": "main",
      "sourceRoot": "apps/user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user/tsconfig.app.json"
      }
    },
    "email": {
