    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-ws": "^10.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.0",
    "better-sqlite3": "^11.1.2",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "image-size": "^1.1.1",
    "mime-types": "^2.1.35",
    "nanoid": "^5.0.7",
    "openai": "^4.104.0",
