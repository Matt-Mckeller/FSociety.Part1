# ─────────── Paths ───────────
# Absolute path to the folder containing your images + library.db
GALLERY_ROOT=./assets

# Optional: root of the marketing-video plan (parent of GALLERY_ROOT).
# Used to resolve `file:` references in seeds. Defaults to dirname(GALLERY_ROOT).
# PLANS_ROOT=/absolute/path/to/marketing-video-see

# ─────────── Server ───────────
API_PORT=4000
WEB_PORT=5173

# ─────────── OpenAI ───────────
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5-pro
OPENAI_IMAGE_MODEL=gpt-image-2

# ─────────── Runway ───────────
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=gen4_turbo

# ─────────── Google (Gemini image + Veo video) ───────────
# Single AI Studio key powers both image generation and Veo video.
GOOGLE_API_KEY=
# Default image model. For scene/edit work override with the Pro model:
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# GEMINI_IMAGE_MODEL=gemini-3.1-pro-image-preview   # Pro — slow, use variations=1
VEO_MODEL=veo-3.1-generate-preview

# ─────────── Provider selection ───────────
# 'auto' = prefer google > openai/runway > fake. Force a specific provider here if needed.
# Images are pinned to OpenAI: under 'auto' a present GOOGLE_API_KEY wins, which
# would silently route image work back to Gemini.
IMAGE_GENERATE_PROVIDER=openai     # gemini | openai | fake | auto
IMAGE_EDIT_PROVIDER=openai         # gemini | openai | fake | auto
# ANIMATE_PROVIDER=veo              # veo | runway | fake | auto
