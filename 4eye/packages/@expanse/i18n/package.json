{
  "name": "@expanse/i18n",
  "version": "0.0.1",
  "description": "Internationalization utilities for Expanse applications",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./decorators": {
      "import": "./src/decorators/index.ts",
      "types": "./src/decorators/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "@emotion/react": "^11.0.0",
    "@storybook/react": "^8.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@emotion/cache": "^11.13.5",
    "stylis": "^4.3.6",
    "stylis-plugin-rtl": "^2.1.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@storybook/react": "^10.0.0",
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "expanse",
    "i18n",
    "internationalization",
    "locale",
    "timezone",
    "currency",
    "storybook",
    "rtl"
  ],
  "license": "MIT"
}
