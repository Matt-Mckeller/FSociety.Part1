{
  "name": "@expanse/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared, presentation-only UI components built on MUI with theme integration",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".":            "./src/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./components": "./src/components/index.ts",
    "./utils":      "./src/utils/index.ts",
    "./typography": "./src/typography/index.ts"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@mui/material": "^9.0.0",
    "@mui/icons-material": "^9.0.0",
    "gsap": "^3.12.0"
  },
  "dependencies": {
    "@expanse/theme": "workspace:*",
    "gsap": "^3.12.0"
  },
  "devDependencies": {
    "@expanse/storybook-config": "workspace:*",
    "@storybook/addon-a11y": "^10.3.4",
    "@storybook/addon-docs": "^10.3.4",
    "@storybook/react-vite": "^10.3.4",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^8.0.0",
    "eslint-plugin-storybook": "^10.3.4",
    "jest": "^29.0.0",
    "storybook": "^10.3.4",
    "typescript": "^5.0.0",
    "vite": "^8.0.3"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
