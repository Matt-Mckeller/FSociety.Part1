# Public site origin (canonical URLs, sitemap, og:image)
NEXT_PUBLIC_SITE_URL=https://www.expanseservices.com

# GCS prefix for /media/* (middleware 302). Unset to serve local public/media.
NEXT_PUBLIC_MEDIA_BASE=https://storage.googleapis.com/expanse-public-assets/yen

# Optional pre-release gate. Both must be set to enable; unset either to open the site.
SITE_ACCESS_USER=preview
SITE_ACCESS_PASSWORD=change-me

# Heart.Evolve / evolve.love on the personal profile. Required to unlock Core → Media.
# Unset = the album stays locked. Cookie is an HMAC of this value (httpOnly).
EVOLVE_LOVE_PASSWORD=change-me

# Instagram Graph API publish (Business/Creator only). Leave unset for manual upload.
# IG_USER_ID=
# IG_ACCESS_TOKEN=
# Public HTTPS folder that mirrors Media/Instagram/_publish/day1/ (feed-carousel/, stories-capture/)
# IG_IMAGE_BASE_URL=https://storage.googleapis.com/expanse-public-assets/yen/ig-publish/day1
# IG_GRAPH_HOST=https://graph.facebook.com/v21.0
