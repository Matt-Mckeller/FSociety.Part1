{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@4eye/core/*": ["../../packages/@4eye/core/src/*"],
      "@4eye/features": ["../../packages/@4eye/features/src"],
      "@4eye/features/*": ["../../packages/@4eye/features/src/*"],
      "@4eye/ai-sdk": ["../../packages/@4eye/ai-sdk/src"],
      "@4eye/ai-sdk/*": ["../../packages/@4eye/ai-sdk/src/*"],
      "@4eye/icons": ["../../packages/@4eye/icons/src"],
      "@4eye/icons/*": ["../../packages/@4eye/icons/src/*"],
      "@4eye/types": ["../../packages/@4eye/types/src"],
      "@4eye/types/*": ["../../packages/@4eye/types/src/*"],
      "@expanse/brand-core": ["../../packages/@expanse/brand-core/src"],
      "@expanse/brand-core/*": ["../../packages/@expanse/brand-core/src/*"],
      "@expanse/character/*": ["../../packages/@expanse/character/src/*"],
      "@expanse/hud": ["../../packages/@expanse/hud/src"],
      "@expanse/hud/*": ["../../packages/@expanse/hud/src/*"],
      "@expanse/map": ["../../packages/@expanse/map/src"],
      "@expanse/map/*": ["../../packages/@expanse/map/src/*"],
      "@expanse/scoring": ["../../packages/@expanse/scoring/src"],
      "@expanse/scoring/*": ["../../packages/@expanse/scoring/src/*"],
      "@expanse/shell": ["../../packages/@expanse/shell/src"],
      "@expanse/shell/*": ["../../packages/@expanse/shell/src/*"],
      "@expanse/theme": ["../../packages/@expanse/theme/src"],
      "@expanse/theme/*": ["../../packages/@expanse/theme/src/*"],
      "@expanse/ui": ["../../packages/@expanse/ui/src"],
      "@expanse/ui/*": ["../../packages/@expanse/ui/src/*"],
      "@4eye/web/*": ["../4eye-web-mockup/src/*"],
      "@yen/content": ["../../packages/@yen/content/src"],
      "expanse.ui/points": ["../../packages/@expanse/brand-core/src/game/points/_stub/points.ts"],
      "expanse.ui/points/*": ["../../packages/@expanse/brand-core/src/game/points/_stub/*"],
      "@yen/content/*": ["../../packages/@yen/content/src/*"]
    },
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
