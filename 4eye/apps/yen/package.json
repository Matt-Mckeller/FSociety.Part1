{
  "name": "yen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:fresh": "node scripts/dev.mjs --fresh",
    "dev:webpack": "node scripts/dev.mjs --webpack",
    "build": "node scripts/build-docs-index.mjs && node scripts/build-photo-manifest.mjs && next build && node scripts/check-bundle-size.mjs",
    "budget": "node scripts/check-bundle-size.mjs",
    "deploy": "bash ../../docker/deploy-yen-cloudrun.sh all",
    "deploy:build": "bash ../../docker/deploy-yen-cloudrun.sh build",
    "deploy:release": "bash ../../docker/deploy-yen-cloudrun.sh release",
    "deploy:media": "bash ../../docker/deploy-yen-cloudrun.sh media",
    "start": "next start -p 3400",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.strict.json",
    "test": "node --experimental-strip-types --test src/lib/site-access.test.ts && node --test scripts/test/*.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "analyze": "ANALYZE=true next build",
    "docs": "node scripts/build-docs-index.mjs",
    "photos": "node scripts/build-photo-manifest.mjs",
    "photos:export": "node scripts/export-platform-media.mjs && node scripts/build-photo-manifest.mjs",
    "ig:verify": "node scripts/verify-ig-publish.mjs day1",
    "ig:publish": "node scripts/publish-instagram.mjs",
    "typecheck:all": "tsc --noEmit",
    "apps": "node scripts/build-mounted-apps.mjs",
    "shots": "node scripts/capture-doc-shots.mjs"
  },
  "dependencies": {
    "@4eye/ai-sdk": "workspace:*",
    "@4eye/features": "workspace:*",
    "@4eye/icons": "workspace:*",
    "@4eye/types": "workspace:*",
    "@4eye/web": "workspace:*",
    "@emotion/cache": "^11.13.0",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@expanse/brand-core": "workspace:*",
    "@expanse/character": "workspace:*",
    "@expanse/hud": "workspace:*",
    "@expanse/lens": "workspace:*",
    "@expanse/scoring": "workspace:*",
    "@expanse/shell": "workspace:*",
    "@expanse/theme": "workspace:*",
    "@expanse/ui": "workspace:*",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@yen/content": "workspace:*",
    "animejs": "^4.4.1",
    "framer-motion": "^11.18.2",
    "gsap": "^3.12.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "marked": "^18.0.9",
    "typescript": "^5.6.0"
  }
}