# ==============================================
# 4eye API - Environment Configuration
# ==============================================

# ----------------
# Application
# ----------------
NODE_ENV=development
API_PORT=3001

# ----------------
# Database
# ----------------
# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
# Development example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/4eye_dev

# Production example (use strong credentials):
# DATABASE_URL=postgresql://4eye_user:strong_password@localhost:5432/4eye_prod

# ----------------
# Authentication & Security
# ----------------
# JWT Secret for access tokens (REQUIRED in production)
# Generate: openssl rand -base64 64
JWT_SECRET=dev-jwt-secret-DO-NOT-USE-IN-PRODUCTION

# JWT Refresh Token Secret (should be different from JWT_SECRET)
# Generate: openssl rand -base64 64
JWT_REFRESH_SECRET=dev-refresh-secret-DO-NOT-USE-IN-PRODUCTION

# ----------------
# OAuth Providers
# ----------------
# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign In (optional)
# Get from: https://developer.apple.com/account/
# APPLE_CLIENT_ID=your-apple-service-id
# APPLE_TEAM_ID=your-apple-team-id
# APPLE_KEY_ID=your-apple-key-id
# APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey_KEYID.p8

# ----------------
# CORS Configuration
# ----------------
# Frontend URL for CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Production example:
# CORS_ORIGIN=https://4eye.ai,https://www.4eye.ai

# ----------------
# OpenAI / AI Services
# ----------------
# Required: Your OpenAI API key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Realtime API Model (default: gpt-4o-realtime)
OPENAI_REALTIME_MODEL=gpt-4o-realtime

# Whisper Model for transcription (default: whisper-1)
# WHISPER_MODEL=whisper-1

# ----------------
# Email Service
# ----------------
# Email service for password reset, verification, welcome emails, etc.
# 
# Option 1: SendGrid (recommended - https://sendgrid.com)
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxx
#
# Option 2: SMTP (Gmail, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
#
# Common settings:
EMAIL_FROM=noreply@4eye.ai
APP_URL=http://localhost:3000

# ----------------
# Storage (Future)
# ----------------
# AWS S3 for file uploads
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=4eye-uploads

# ----------------
# Monitoring & Logging (Future)
# ----------------
# Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ----------------
# Development Tools
# ----------------
# TypeScript Types Path (for AI type reader)
TYPES_BASE_PATH=../../packages

# ----------------
# Security Notes
# ----------------
# 1. NEVER commit this file with real credentials
# 2. Use strong, unique values for JWT_SECRET and JWT_REFRESH_SECRET in production
# 3. Keep OpenAI API key secure - it has billing attached
# 4. Use environment-specific .env files (.env.development, .env.production)
# 5. Consider using a secrets manager (AWS Secrets Manager, HashiCorp Vault) in production
