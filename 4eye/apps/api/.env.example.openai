# OpenAI Configuration for 4eye API

# Required: Your OpenAI API key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Realtime API Model
# Default: gpt-4o-realtime (stable production model)
# 
# Available Models (check OpenAI Platform for latest):
#   - gpt-4o-realtime           (recommended - stable production)
#   - gpt-4.5-realtime          (if available - newer architecture)
#   - gpt-4o-realtime-preview-* (preview versions for testing)
#
# Cost: ~$0.06/minute for real-time streaming
OPENAI_REALTIME_MODEL=gpt-4o-realtime

# Optional: Batch Whisper Model
# Default: whisper-1
# Cost: $0.006/minute for batch transcription
# WHISPER_MODEL=whisper-1
