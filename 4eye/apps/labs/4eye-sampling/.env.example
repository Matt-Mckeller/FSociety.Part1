# ==============================================
# 4eye Web App - Environment Configuration
# ==============================================

# ----------------
# API Connection
# ----------------
# Backend GraphQL API URL
# Development:
NEXT_PUBLIC_API_URL=http://localhost:3001/graphql

# Production example:
# NEXT_PUBLIC_API_URL=https://api.4eye.ai/graphql

# ----------------
# Application URLs
# ----------------
# Base URL for the web app (used for OAuth redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production example:
# NEXT_PUBLIC_APP_URL=https://4eye.ai

# ----------------
# OAuth Providers
# ----------------
# Google OAuth Client ID (must match backend configuration)
# Get from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ----------------
# Feature Flags (Optional)
# ----------------
# Enable/disable features during development
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_LIVE_SESSIONS=true
# NEXT_PUBLIC_ENABLE_AI_FEATURES=true

# ----------------
# Analytics (Future)
# ----------------
# Google Analytics
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# PostHog
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ----------------
# Third-Party Services (Future)
# ----------------
# Stripe for payments
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Sentry for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ----------------
# Development Tools
# ----------------
# Show debug information in dev mode
# NEXT_PUBLIC_DEBUG=true

# ----------------
# Security Notes
# ----------------
# 1. All NEXT_PUBLIC_ variables are exposed to the browser
# 2. NEVER put secrets or API keys in NEXT_PUBLIC_ variables
# 3. Backend-only secrets should go in the API's .env file
# 4. Use different values for development, staging, and production
