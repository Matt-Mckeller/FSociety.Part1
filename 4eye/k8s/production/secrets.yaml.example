# ==============================================
# 4eye Production Secrets Template
# ==============================================
# DO NOT commit actual secrets to git!
#
# To create the secret in your cluster:
#   kubectl create secret generic 4eye-api-secrets \
#     --namespace=four-eye-production \
#     --from-literal=DATABASE_URL='postgresql://USER:PASSWORD@CLOUD_SQL_IP:5432/foureye' \
#     --from-literal=REDIS_URL='redis://REDIS_HOST:6379' \
#     --from-literal=JWT_SECRET='YOUR_SECURE_JWT_SECRET'
#
# Or apply this file after filling in values:
#   kubectl apply -f secrets.yaml
# ==============================================

apiVersion: v1
kind: Secret
metadata:
  name: 4eye-api-secrets
  namespace: four-eye-production
type: Opaque
stringData:
  DATABASE_URL: "postgresql://foureye:CHANGE_ME@CLOUD_SQL_PRIVATE_IP:5432/foureye"
  REDIS_URL: "redis://REDIS_HOST:6379"
  JWT_SECRET: "CHANGE_ME_TO_A_SECURE_RANDOM_STRING"
