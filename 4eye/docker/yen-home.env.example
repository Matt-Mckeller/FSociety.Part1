# Copy to the repository root as .env.yen-home; never commit the copied file.
# Configure a dedicated Cloudflare Tunnel and DNS route before deployment.

# Final public origin; replace this example hostname. It must use HTTPS.
YEN_SITE_URL=https://replace-with-approved-hostname.example
YEN_MEDIA_BASE=https://storage.googleapis.com/expanse-public-assets/yen

# Use a unique tag per deployment; record the built image digest for rollback.
YEN_IMAGE_TAG=yen-home-2026-09-27.1

# Pin the cloudflared calendar-version release (and optionally its sha256 digest).
# --token-file requires cloudflared 2025.4.0 or newer.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.3@sha256:072c067d25ccbe61d46e18f0d0723255f2bb5304f7317caa95b27031520ff92c
CLOUDFLARE_TUNNEL_TOKEN_FILE=./.secrets/yen-cloudflare-token

# Choose exactly one access mode. Preview requires Yen Basic Auth; Cloudflare Access is recommended.
YEN_ACCESS_MODE=preview
CLOUDFLARE_ACCESS_CONFIRMED=NO
YEN_PREVIEW_WITHOUT_ACCESS_CONFIRMED=NO
YEN_PUBLIC_RELEASE_CONFIRMED=NO
SITE_ACCESS_USER=preview
SITE_ACCESS_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_16_CHARACTERS

# Optional. Leave empty unless the protected Evolve Love feature should be enabled.
EVOLVE_LOVE_PASSWORD=
