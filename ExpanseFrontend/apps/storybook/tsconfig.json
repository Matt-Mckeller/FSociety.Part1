{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@expanseEdu/*": ["../expanseEdu/src/*"],
      "expanse.ui/*": ["../../packages/ui/*"],
      "expanse.dynamicAssets": ["../../packages/dynamicAssets"],
      "expanse.dynamicAssets/*": ["../../packages/dynamicAssets/*"],
      "expanse.staticAssets": ["../../packages/staticAssets"],
      "expanse.staticAssets/*": ["../../packages/staticAssets/*"]
    }
  },
  "include": ["src", ".storybook"],
}
