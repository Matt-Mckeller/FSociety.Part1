{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next",
      },
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@root/*": ["./src/*"],
      "@personalNext/modules/*": ["./src/modules/*"],
      "@personalNext/modules": ["./src/modules"],
      "@personalNext/content/*": ["./src/modules/content/*"],
      "@personalNext/content": ["./src/modules/content"],
    },
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/@types",
  ],
  "exclude": ["node_modules"],
}
