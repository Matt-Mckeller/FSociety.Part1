{
  "name": "expanse-frontend",
  "version": "1.0.0",
  "description": "Collection of applications/websites, components, and assets for Expanse's frontend",
  "main": "index.js",
  "engines": {
    "node": ">=24.4.0",
    "npm": ">=9.6.7"
  },
  "scripts": {
    "test": "jest ./packages/tests/*",
    "removeNodeModules": "rm -rf node_modules && rm -f package-lock.json && rm -rf ./apps/personalNext/node_modules &&  rm -f ./apps/personalNext/package-lock.json && rm -rf ./packages/ui/node_modules && rm -f ./packages/ui/package-lock.json && rm -rf ./packages/dynamicAssets/node_modules && rm -f ./packages/dynamicAssets/package-lock.json",
    "lottie:analyze": "ts-node scripts/lottie/naming/analyze.ts",
    "lottie:generate-names": "ts-node scripts/lottie/naming/generateNames.ts",
    "lottie:apply-names": "ts-node scripts/lottie/naming/applyNames.ts",
    "lottie:validate": "ts-node scripts/lottie/naming/validate.ts"
  },
  "workspaces": [
    "packages/ui",
    "packages/ui/points",
    "packages/ui/auth",
    "packages/ui/application",
    "packages/tests",
    "apps/playground",
    "apps/personalNext",
    "apps/expanseEdu",
    "apps/expanse-services",
    "apps/lotties",
    "apps/storybook",
    "apps/4eye"
  ],
  "author": "",
  "license": "Proprietary",
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "prettier": "3.2.3",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^7.0.1",
    "webpack": "^5.90.1",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0"
