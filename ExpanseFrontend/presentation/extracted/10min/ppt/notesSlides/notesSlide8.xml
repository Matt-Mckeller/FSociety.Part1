4343400"/><a:ext cx="5486400" cy="4114800"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr anchorCtr="0" anchor="t" bIns="91425" lIns="91425" spcFirstLastPara="1" rIns="91425" wrap="square" tIns="91425"><a:noAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr lang="en" sz="1300"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Todo: revise, improve focus on instant gratification, convert notes to data points</a:t></a:r><a:endParaRPr sz="1300"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr lang="en" sz="1300"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Todo: May want to clarify I do not think social media is a bad thing, actually a good thing, more that this and other aspects of the internet have changed our expectations and rewired the brains of our youth, and other environments have not yet adapted which makes it even more difficult to focus, but that it can also be fixed with knowledge, understanding, and a growth mindset</a:t></a:r><a:endParaRPr sz="1300"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr b="1" sz="1300"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:srgbClr val="131619"/></a:solidFill></a:rPr><a:t>“classroom environment has not adapted to the fast-paced, instant-gratification lifestyle shaped by social media and technology, leading to students' struggles with attention and participation in on-campus activities</a:t></a:r><a:endParaRPr b="1" sz="1300"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr b="1" sz="1300"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>When I was a kid gaming was relatively uncommon, and devices/computer use was being adopted but I was one of the forerunners. Now it’s everywhere. 85% of teens play games.</a:t></a:r><a:br><a:rPr b="1" lang="en" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr></a:br><a:r><a:rPr b="1" lang="en" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>+ games and social media have evolved to be even faster paced and more stimulating than they were before. And the schools are struggling to keep up. In the same way that pac man was not as fast paced or engaging as world of warcraft, the original facebook was not as stimulating and fast paced as tiktok. </a:t></a:r><a:endParaRPr b="1" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr sz="200"/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>The students minds are trained to need for immediate gratification. How can teachers and schools compete with Multi Million dollar netflix budgets and tiktok? </a:t></a:r><a:endParaRPr b="1" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr b="1" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>The kids are endlessly scrolling and the teachers are lost and frustrated.</a:t></a:r><a:endParaRPr b="1" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr b="1" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>&lt;Audience Involvement Option: I’m sure many of you struggled to focus in school. Maybe it was a specific class, maybe it was a specific teacher, or if you’re like me it was almost every class. It’s even worse for your kids.&gt;</a:t></a:r><a:endParaRPr b="1" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>&lt;Now, Imagine what a low engagement school is like. Imagine what kids in poverty are experiencing, any ideas what that might look like?&gt;</a:t></a:r><a:endParaRPr b="1" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>&lt;Intro to the fact that I did a case study of a low engagement high school in KC&gt;</a:t></a:r><a:endParaRPr b="1" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>&lt;Example Case Study Story(s)&gt;</a:t></a:r><a:endParaRPr b="1" sz="900"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>