:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en" sz="1800"><a:solidFill><a:srgbClr val="595959"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Gamification is really about the human mind and human society. Its about how do we get people to enjoy doing something and what do they enjoy. How do we guide them to do the things that we want them to do. Ideally its used for good.</a:t></a:r><a:endParaRPr b="1" sz="1800"><a:solidFill><a:srgbClr val="595959"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en" sz="1800"><a:solidFill><a:srgbClr val="595959"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Goals</a:t></a:r><a:endParaRPr b="1" sz="1800"><a:solidFill><a:srgbClr val="595959"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr lang="en" sz="1800"><a:solidFill>