="4343400"/><a:ext cx="5486400" cy="4114800"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr anchorCtr="0" anchor="t" bIns="91425" lIns="91425" spcFirstLastPara="1" rIns="91425" wrap="square" tIns="91425"><a:noAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>The boredom and lack of focus leads to decreased performance and attendance, behavior problems, and frustrated parents, teachers, and even students.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Bored Students</a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t> Students are bored, school is not stimulating enough resulting in decreased motivation and focus.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Missing Purpose</a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t> Too many kids don’t understand the value or purpose of their education</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Delayed Gratification</a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t> compared to Social Media, Video Games, and other Entertainment are hard for schools and classrooms to compete with.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Teachers, principals, parents, districts all want their students engaged.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="600"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en" sz="1800"><a:solidFill><a:srgbClr val="595959"/></a:solidFill></a:rPr><a:t>Frustrated Teachers alongside Parents and Students Yearning for more. Teachers are desperate, districts are looking for answers, and the economy stands to benefit tremendously</a:t></a:r><a:endParaRPr sz="1800"><a:solidFill><a:srgbClr val="595959"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en" sz="1800"><a:solidFill><a:srgbClr val="595959"/></a:solidFill></a:rPr><a:t>Delayed gratification from schools when compared to social media, video games, and other engagement factors makes it hard for schools to keep up. Their brains are conditioned to immediate gratification with higher immediate reward value than schools are offering. Students are continuously learning but are only said to have reached the next level once a year.</a:t></a:r><a:endParaRPr sz="1800"><a:solidFill><a:srgbClr val="595959"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>For most students, school is something that is done to them, not something they choose to do nor do they understand why they are doing it.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Kids are bored, school is not stimulating enough. It isn't keeping up with social media, and 250 million dollar netflix movies or modern video games</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Kids need quicker gratification</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>around 45-50% of students report being engaged in school, with a noticeable decline in engagement as students move from elementary to high school, with Gallup surveys showing that roughly 74% of fifth graders are highly engaged compared to only about one-third of high schoolers</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>-Gallup</a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:uFill><a:noFill/></a:uFill><a:hlinkClick r:id="rId2"><a:extLst><a:ext uri="{A12FA001-AC4F-418D-AE19-62706E023703}"><ahyp:hlinkClr val="tx"/></a:ext></a:extLst></a:hlinkClick></a:rPr><a:t> </a:t></a:r><a:r><a:rPr lang="en" u="sng"><a:solidFill><a:schemeClr val="hlink"/></a:solidFill><a:hlinkClick r:id="rId3"/></a:rPr><a:t>https://www.gallup.com/education/244022/school-engagement-talk.aspx</a:t></a:r><a:endParaRPr u="sng"><a:solidFill><a:schemeClr val="hlink"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="600"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"/><a:t>&lt;Audience Involvement&gt;</a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Opportunity Engagement</a:t></a:r><a:endParaRPr b="1"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Even in places with the highest levels of engagement the engagement and motivation can still be improved in a healthy way. More tools for learning a growth oriented mindset, improving mental health, teaching positivity, and tools for reinforcing positive behavior will continue to be beneficial. Add more fun into learning in a way that improves outcomes!</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>GenZ Engagement: Genz needs even more engagement than previous generations. In part this is due to the state of todays technology and the stimulation from so many other areas such as social media.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Teachers, principals, parents, districts all want their students engaged.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Engaged students are 2.5 times more likely to say that they get excellent grades and do well in school, and they are 4.5 times more likely to be hopeful about the future than their actively disengaged peers</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="600"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"/><a:t>Improvement Notes:</a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"/><a:t>School vs Learning Environment / Platform and School</a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr/></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>