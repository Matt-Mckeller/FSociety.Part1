<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:notes xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mv="urn:schemas-microsoft-com:mac:vml" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:c="http://schemas.openxmlformats.org/drawingml/2006/chart" xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:pvml="urn:schemas-microsoft-com:office:powerpoint" xmlns:com="http://schemas.openxmlformats.org/drawingml/2006/compatibility" xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" xmlns:p15="http://schemas.microsoft.com/office/powerpoint/2012/main" xmlns:ahyp="http://schemas.microsoft.com/office/drawing/2018/hyperlinkcolor" showMasterPhAnim="0" showMasterSp="0"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="185" name="Shape 185"/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="186" name="Google Shape;186;g330f8dfe9f6_0_37:notes"/><p:cNvSpPr/><p:nvPr><p:ph idx="2" type="sldImg"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="381300" y="685800"/><a:ext cx="6096000" cy="3429000"/></a:xfrm><a:custGeom><a:rect b="b" l="l" r="r" t="t"/><a:pathLst><a:path extrusionOk="0" h="120000" w="120000"><a:moveTo><a:pt x="0" y="0"/></a:moveTo><a:lnTo><a:pt x="120000" y="0"/></a:lnTo><a:lnTo><a:pt x="120000" y="120000"/></a:lnTo><a:lnTo><a:pt x="0" y="120000"/></a:lnTo><a:close/></a:path></a:pathLst></a:custGeom></p:spPr></p:sp><p:sp><p:nvSpPr><p:cNvPr id="187" name="Google Shape;187;g330f8dfe9f6_0_37:notes"/><p:cNvSpPr txBox="1"/><p:nvPr><p:ph idx="1" type="body"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="685800" y="4343400"/><a:ext cx="5486400" cy="4114800"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr anchorCtr="0" anchor="t" bIns="91425" lIns="91425" spcFirstLastPara="1" rIns="91425" wrap="square" tIns="91425"><a:noAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Mental health is related to engagement</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>PBIS has also been linked to improvements in academic outcomes, such as increased student engagement, improved grades, and higher graduation rates.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>We seek happiness. We crave it. We pay for it.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>The correlation between employee happiness and company profitability is undeniable. Numerous studies have shown that companies with high employee morale significantly outperform those with low morale.</a:t></a:r><a:endParaRPr b="1"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr u="sng"><a:solidFill><a:schemeClr val="hlink"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>The CDC's Youth Risk Behavior Survey (YRBS)</a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t> has consistently shown that students who report mental health challenges, such as feeling sad or hopeless, are more likely to miss school and engage in risky behaviors.</a:t></a:r><a:endParaRPr b="1"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr b="1"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Enhanced innovation: A positive work environment fosters creativity and problem-solving.</a:t></a:r><a:endParaRPr b="1"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr b="1"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Environment as a Catalyst:</a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t> The school environment, including the physical space, the social dynamics, and the teaching practices, can significantly impact student behavior.</a:t></a:r><a:endParaRPr b="1"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Socioeconomic Factors:</a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t> Poverty, lack of access to resources, and community violence can create significant stress for families and children.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>May add: Negativity bias, but does it help the argument and presentation/pitch? I.e. 10 good things happen and 1 bad which are you more likely to remember, but we prefer positive, and typically choose positive for ourselves</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>	We seek the satisfaction of success and recognition, we crave it. We enjoy confidence boosts and compliments. Its addicting. // validate</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Closing the gap: for whom is recognition more impactful? Those who are not used to receiving it or those used to it</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Approximately 99% of humans experience sadness and other negative emotions but prefer positive emotions.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>People seek more happiness. They want to avoid pain. In a sense, engagement is happiness, and people pay for happiness.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Personally I think theres a bigger problem than these numbers let on. Mental illness and mental health are different things.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Students with toxic households who have grown up being told no over and over and punished for their behavior with limited rewards and limited confidence boosts. </a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Students without role models teaching them they can achieve whatever they set their minds to.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Lack of recognition has negative consequences</a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t> Feeling unappreciated or ignored can lead to decreased motivation, job satisfaction, and even mental health issues like stress, anxiety, and depression</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en" u="sng"><a:solidFill><a:schemeClr val="hlink"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/><a:hlinkClick r:id="rId2"/></a:rPr><a:t>https://www.gallup.com/workplace/236441/employee-recognition-low-cost-high-impact.aspx#:~:text=Further%2C%20employees%20who%20do%20not,quit%20in%20the%20next%20year</a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>. </a:t></a:r><a:endParaRPr b="1"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Recognition is a basic human need. </a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Maslow's hierarchy of needs places esteem needs, which include recognition, respect, and appreciation, high on the pyramid.1 This suggests that a significant portion of people are motivated by these needs.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Recognition drives motivation and engagement:</a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t> Studies consistently show a strong correlation between recognition and employee engagement, performance, and retention.</a:t></a:r><a:r><a:rPr baseline="30000" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t> 1 </a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>For example, Gallup research has found that employees who receive regular recognition are more likely to be engaged, productive, and stay with their company</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>Recognition is a basic human need:</a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t> Abraham Maslow's hierarchy of needs places esteem needs, which include recognition, respect, and appreciation, high on the pyramid. This suggests that a significant portion of people are motivated by these needs.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en" u="sng"><a:solidFill><a:schemeClr val="hlink"/></a:solidFill><a:hlinkClick r:id="rId3"/></a:rPr><a:t>https://web.theinstitutes.org/blog/power-recognition-employee-engagement-and-performance#:~:text=A%20recognized%20employee%2C%20on%20the,as%20likely%20to%20be%20engaged</a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>.</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en" u="sng"><a:solidFill><a:schemeClr val="hlink"/></a:solidFill><a:hlinkClick r:id="rId4"/></a:rPr><a:t>https://www.gallup.com/workplace/236441/employee-recognition-low-cost-high-impact.aspx#:~:text=Recognition%20not%20only%20boosts%20individual,the%20company%2C%20leading%20to%20higher</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1100"/><a:buFont typeface="Arial"/><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr u="sng"><a:solidFill><a:schemeClr val="hlink"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="600"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a