tserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>they are worthy, capable, and working towards a goal.</a:t></a:r><a:r><a:rPr lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>.</a:t></a:r><a:endParaRPr><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>To accomplish this we can implement rewards in </a:t></a:r><a:r><a:rPr b="1" lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>small quantities</a:t></a:r><a:r><a:rPr lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>, and random chance for complete rewards.</a:t></a:r><a:endParaRPr><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Instead of receiving a complete scholarship students can receive </a:t></a:r><a:r><a:rPr b="1" lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>pieces required to build a scholarship opportunity</a:t></a:r><a:r><a:rPr lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>, even if that scholarship opportunity is valued at $10-$100 with rare potential for higher valued scholarships. They make progress towards this over time and are continuously reminded of potential options. </a:t></a:r><a:endParaRPr><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>I.e. </a:t></a:r><a:r><a:rPr b="1" lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>receive 1-2 essences per loot box, combine 100 essences to create a Scholarship option</a:t></a:r><a:r><a:rPr lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t> whenever they are ready, or complete scholarship opportunities for specific higher ed institutes that can be</a:t></a:r><a:r><a:rPr b="1" lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t> deconstructed into 10-30% of the essences</a:t></a:r><a:r><a:rPr lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t> and recombined into a different choice.</a:t></a:r><a:endParaRPr><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="1200"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en"><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:rPr><a:t>Larger scholarship opportunities may be available, perhaps to the highest performers, competition winners, or through lotteries. To reach the most people we can focus on micro options.</a:t></a:r><a:endParaRPr><a:latin typeface="Montserrat Alternates"/><a:ea typeface="Montserrat Alternates"/><a:cs typeface="Montserrat Alternates"/><a:sym typeface="Montserrat Alternates"/></a:endParaRPr></a:p></p:txBody></p:sp><p:pic><p:nvPicPr><p:cNvPr id="858" name="Google Shape;858;p92"/><p:cNvPicPr preferRelativeResize="0"/><p:nvPr/></p:nvPicPr><p:blipFill><a:blip r:embed="rId3"><a:alphaModFix/></a:blip><a:stretch><a:fillRect/></a:stretch></p:blipFill><p:spPr><a:xfrm><a:off x="6933887" y="2699775"/><a:ext cx="1441035" cy="1443252"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></p:spPr></p:pic><p:pic><p:nvPicPr><p:cNvPr id="859" name="Goo