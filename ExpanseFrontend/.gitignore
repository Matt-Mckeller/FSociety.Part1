node_modules
notes/*
apps/archive
apps/archive/*

# dependencies
/node_modules

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo

# next.js
.next

# logging
logs/
/logs/

.env*
!.env.example
/docs/*
